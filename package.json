    "ean-8",
    "ean-13",
    "generator",
    "gs1",
    "gtin",
    "itf",
    "svg",
    "upc",
    "upc-a",
    "upc-e"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "name": "svg-barcode-generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/Avaray/svg-barcode-generator"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "version": "1.0.0"
}
