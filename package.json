{
  "author": "Dawid Wasowski",
  "description": "Lightweight SVG barcode generator for browsers, mobile, and modern JS runtimes",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@zxing/library": "^0.23.0",
    "pngjs": "^7.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "browser": "./dist/index.iife.js",
      "import": "./dist/index.mjs",
