{
  "name": "svg-barcode-generator",
  "description": "Barcode Generator compatible with Mobile, Browsers and JavaScript Runtimes",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "browser": "./dist/index.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "barcode",
    "codabar",
    "code-128",
    "code-39",
    "code-93",
    "code",
    "code128",
    "code39",
    "code93",
    "ean-13",
    "ean-8",
    "ean",
    "ean13",
    "ean8",
    "generator",
    "gs1",
    "gtin",
    "interleaved2of5",
    "itf",
    "svg",
    "typescript",
    "upc-a",
    "upc-e",
    "upc"
  ],
  "author": {
    "name": "Dawid Wasowski",
    "email": "deffqqq@gmail.com",
    "url": "https://dav.one/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Avaray/svg-barcode-generator"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@zxing/library": "^0.23.0",
    "pngjs": "^7.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
